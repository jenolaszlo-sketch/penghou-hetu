<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Penghou.Hetu\Penghou.Hetu.csproj" />
    <ProjectReference Include="..\Penghou.Hetu.Abstractions\Penghou.Hetu.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LatticeDbSharp" Version="0.2.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>Penghou.Hetu.LatticeDb</PackageId>
    <Title>Penghou Hetu LatticeDb Provider</Title>
    <Authors>Penghou.Hetu contributors</Authors>
    <Description>Durable embedded LatticeDB graph store provider for Penghou.Hetu.</Description>
    <PackageTags>latticedb;graph-database;code-analysis;knowledge-graph</PackageTags>
    <RepositoryUrl>https://github.com/jenolaszlo-sketch/penghou-hetu</RepositoryUrl>
    <PackageProjectUrl>https://github.com/jenolaszlo-sketch/penghou-hetu</PackageProjectUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsPackable>true</IsPackable>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
